# зависимости
node_modules/

# собранные standalone-бинарники (55+ МБ) — распространяются через
# GitHub Releases, а не через сам репозиторий
host/dist/

# генерируется register-windows.js/register-unix.js на конкретной машине
# (абсолютные пути к node.exe/бинарнику этого пользователя)
host/install/native-host-launcher.bat
host/install/native-host-launcher.sh
host/install/*.generated.json

# снимок extension/ для standalone-сборки, пересоздаётся перед каждым build:*
host/src/embedded-extension.js

# снимок docs/*.html для раздачи с ai-agent-notify.ru, пересоздаётся
# scripts/sync-public.js перед каждым тестом/деплоем relay
relay/public/

# логи, ОС-мусор
*.log
.DS_Store
Thumbs.db
