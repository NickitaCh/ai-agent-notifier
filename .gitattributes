# Нормализуем текстовые файлы на LF в репозитории — Git сам конвертирует
# в CRLF при чекауте на Windows, если у тебя core.autocrlf=true. Без этого
# на разных ОС/настройках диффы шумят только из-за окончаний строк.
* text=auto eol=lf

# .bat нужен буквально CRLF — так исторически ожидает cmd.exe
*.bat text eol=crlf

# бинарные файлы — не трогать вообще
*.png binary
